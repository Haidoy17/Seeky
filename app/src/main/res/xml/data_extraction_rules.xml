<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup="false" não bloqueia a transferência entre aparelhos.
     Os cofres cifrados dependem de chaves do AndroidKeyStore que não saem do
     telefone, e o token de lançamento interno é secreto por aparelho: nunca são copiados. -->
<data-extraction-rules>
 <cloud-backup>
  <exclude domain="root" path="."/>
  <exclude domain="file" path="."/>
  <exclude domain="database" path="."/>
  <exclude domain="sharedpref" path="."/>
  <exclude domain="external" path="."/>
 </cloud-backup>
 <device-transfer>
  <exclude domain="sharedpref" path="seeky_ai_vault.xml"/>
  <exclude domain="sharedpref" path="cloud_vault.xml"/>
  <exclude domain="sharedpref" path="seeky_internal_launch.xml"/>
  <exclude domain="sharedpref" path="diagnostics.xml"/>
 </device-transfer>
</data-extraction-rules>
