<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/today_root" android:layout_width="match_parent" android:layout_height="match_parent">
 <ImageView android:id="@+id/today_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_bg"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="center_vertical">
  <TextView android:id="@+id/today_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HOJE" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.12" android:maxLines="1"/>
  <TextView android:id="@+id/today_book" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:paddingTop="2dp"/>
  <ImageView android:id="@+id/today_progress" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="8dp" android:scaleType="fitXY"/>
  <TextView android:id="@+id/today_goal" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="1" android:paddingTop="5dp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp">
   <FrameLayout android:id="@+id/today_continue" android:layout_width="0dp" android:layout_weight="1" android:layout_height="34dp"><ImageView android:id="@+id/today_continue_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_pill"/><TextView android:id="@+id/today_continue_text" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="Continuar" android:textSize="12sp" android:textStyle="bold" android:maxLines="1"/></FrameLayout>
   <FrameLayout android:id="@+id/today_listen" android:layout_width="0dp" android:layout_weight="1" android:layout_height="34dp" android:layout_marginLeft="6dp"><ImageView android:id="@+id/today_listen_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_pill"/><TextView android:id="@+id/today_listen_text" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="Ouvir" android:textSize="12sp" android:textStyle="bold" android:maxLines="1"/></FrameLayout>
   <FrameLayout android:id="@+id/today_review" android:layout_width="0dp" android:layout_weight="1" android:layout_height="34dp" android:layout_marginLeft="6dp"><ImageView android:id="@+id/today_review_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_pill"/><TextView android:id="@+id/today_review_text" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="Rever" android:textSize="12sp" android:textStyle="bold" android:maxLines="1"/></FrameLayout>
  </LinearLayout>
 </LinearLayout>
</FrameLayout>
