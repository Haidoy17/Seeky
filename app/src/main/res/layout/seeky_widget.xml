<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/seeky_widget_root" android:layout_width="match_parent" android:layout_height="match_parent">
 <ImageView android:id="@+id/seeky_widget_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_bg"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:gravity="center_vertical">
  <FrameLayout android:id="@+id/seeky_widget_search" android:layout_width="match_parent" android:layout_height="44dp">
   <ImageView android:id="@+id/seeky_widget_search_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/widget_pill"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="14dp" android:paddingRight="14dp">
    <ImageView android:id="@+id/seeky_widget_search_icon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_w_search"/>
    <TextView android:id="@+id/seeky_widget_search_text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingLeft="10dp" android:text="Pesquisar no Seeky" android:textSize="14sp" android:maxLines="1"/>
   </LinearLayout>
  </FrameLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="10dp">
   <LinearLayout android:id="@+id/seeky_widget_pdf" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal"><ImageView android:id="@+id/seeky_widget_pdf_icon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_w_pdf"/><TextView android:id="@+id/seeky_widget_pdf_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PDF" android:textSize="11sp" android:paddingTop="3dp" android:maxLines="1"/></LinearLayout>
   <LinearLayout android:id="@+id/seeky_widget_image" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal"><ImageView android:id="@+id/seeky_widget_image_icon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_w_image"/><TextView android:id="@+id/seeky_widget_image_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Imagens" android:textSize="11sp" android:paddingTop="3dp" android:maxLines="1"/></LinearLayout>
   <LinearLayout android:id="@+id/seeky_widget_video" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal"><ImageView android:id="@+id/seeky_widget_video_icon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_w_video"/><TextView android:id="@+id/seeky_widget_video_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vídeos" android:textSize="11sp" android:paddingTop="3dp" android:maxLines="1"/></LinearLayout>
   <LinearLayout android:id="@+id/seeky_widget_audio" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal"><ImageView android:id="@+id/seeky_widget_audio_icon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_w_audio"/><TextView android:id="@+id/seeky_widget_audio_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Áudio" android:textSize="11sp" android:paddingTop="3dp" android:maxLines="1"/></LinearLayout>
   <LinearLayout android:id="@+id/seeky_widget_clean" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal"><ImageView android:id="@+id/seeky_widget_clean_icon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_w_clean"/><TextView android:id="@+id/seeky_widget_clean_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Limpeza" android:textSize="11sp" android:paddingTop="3dp" android:maxLines="1"/></LinearLayout>
  </LinearLayout>
 </LinearLayout>
</FrameLayout>
